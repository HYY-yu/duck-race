# Production canonical origin. Use an HTTPS origin only, with no trailing path.
SITE_URL=https://duckracepicker.com

# Public builds are automatic-only. Do not enable this flag in deployment environments.
VITE_ENABLE_MANUAL_MODE=false

# Public PostHog project token and HTTPS ingestion host from project settings.
# Both are required. Vite embeds these values at build time; never use a personal API key.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
# Development sends no events unless explicitly enabled for verification.
VITE_POSTHOG_ENABLE_DEV=false
