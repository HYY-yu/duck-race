{
  "name": "@duck-obstacle-race/duck-rush",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5183 --strictPort",
    "dev:manual": "vite --mode manual --host 127.0.0.1 --port 5183 --strictPort",
    "build": "tsc && vite build && node scripts/check-seo-build.mjs",
    "build:manual": "tsc && vite build --mode manual && DUCK_RUSH_MANUAL_BUILD=true node scripts/check-seo-build.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "dev:rush": "npm run dev",
    "build:rush": "npm run build",
    "test:rush": "npm test",
    "dev:legacy": "npm --prefix archive/duck-circuit run dev",
    "build:legacy": "npm --prefix archive/duck-circuit run build",
    "test:legacy": "npm --prefix archive/duck-circuit test"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.180.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
